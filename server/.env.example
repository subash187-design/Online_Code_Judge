PORT=5000
DATABASE_URL=postgresql://postgres:your_secure_password@postgres:5432/judge_db
JWT_SECRET=replace_with_a_long_random_secret_key_in_production
JWT_EXPIRES_IN=7d
EMAIL_VERIFICATION_TTL_MINUTES=15

# SMTP Email Configuration (e.g. Gmail App Password, SendGrid, Resend, or AWS SES)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="Algomind Online Code Judge" <your_email@gmail.com>
